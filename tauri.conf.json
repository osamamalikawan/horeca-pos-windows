{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horeca Store POS",
  "version": "1.0.1",
  "identifier": "com.osamamalik.horecastorepos",
  "build": {
    "frontendDist": "./.web-src/out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Horeca Store POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3NEZDNDQ3NDk0ODIwOUEKUldTYUlFaEpSOFJQWjNGempIbWovbWJ0bFNhR3RPWFJIZUpxUXRNMllKa202TjJtb0xIc25rengK (run scripts\\setup-updater-key.mjs)",
      "endpoints": [
        "https://github.com/osamamalikawan/horeca-pos-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
